generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Species {
    id          Int    @id @default(autoincrement())
    name        String @unique
    description String?
}

model AttributeDefinition {
    id        Int    @id @default(autoincrement())
    name      String
    type      String                  // number, string, ...
    min       Float?                  // When type has a range
    max       Float?                  // When type has a range
    options   String[]                // For type enum
    optional  Boolean @default(false)
    mutable   Boolean @default(false) // True if attribute can change, e.g. castration
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}

model StatDefinition {
    id        Int     @id @default(autoincrement())
    name      String
    min       Float
    max       Float
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}

model Gene {
    id        Int @id @default(autoincrement())
    name      String
    category  String // Groups genes by type/scope
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}