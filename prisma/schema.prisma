generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Species {
    id          Int      @id @default(autoincrement())
    createdAt   DateTime @default(now())
    name        String   @unique
    description String?
    attributes  AttributeDefinition[]
    stats       StatDefinition[]
    genes       Gene[]
    breeds      Breed[]
}

model AttributeDefinition {
    id        Int     @id @default(autoincrement())
    name      String
    type      String                  // number, string, ...
    min       Float?                  // When type has a range
    max       Float?                  // When type has a range
    options   String[]                // For type enum
    optional  Boolean @default(false)
    mutable   Boolean @default(false) // True if attribute can change, e.g. castration
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
    @@unique([name, speciesId])
}

model StatDefinition {
    id        Int     @id @default(autoincrement())
    name      String
    min       Float
    max       Float
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
    @@unique([name, speciesId])
}

model Gene {
    id              Int      @id @default(autoincrement())
    createdAt       DateTime @default(now())
    name            String
    category        String // Groups genes by type/scope
    loci            Locus[]
    expressionRules ExpressionRule[]
    active          Boolean  @default(true)
    speciesId       Int
    species         Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
    @@unique([name, speciesId])
}

model Locus {
    id      Int  @id @default(autoincrement())
    name    String // e.g. "Extension Locus"
    alleles Allele[]
    geneId  Int
    gene    Gene @relation(fields: [geneId], references: [id], onDelete: Cascade)
}

model Allele {
    id          Int   @id @default(autoincrement())
    name        String // e.g. "Extension E", "Extension e"
    symbol      String // "E", "e"
    dominance   String
    probability Float  // default
    overrides   AlleleOverride[]
    locusId     Int
    locus       Locus @relation(fields: [locusId], references: [id], onDelete: Cascade)
}

// Expression rule defines what behavior a gene has based on the number of dominant alleles
model ExpressionRule {
    id                 Int  @id @default(autoincrement())
    minDominantAlleles Int // What determines expression
    expression         String // Trait displayed, e.g. "Blue eyes"
    geneId             Int
    gene               Gene @relation(fields: [geneId], references: [id], onDelete: Cascade)
}

model Breed {
    id         Int      @id @default(autoincrement())
    createdAt  DateTime @default(now())
    name       String
    active     Boolean  @default(true)
    overrides  AlleleOverride[]
    statRanges StatRange[]
    animals    Animal[]
    speciesId  Int
    species    Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
    @@unique([name, speciesId])
}

// enables individual breeds to alter probabilities
model AlleleOverride {
    id          Int    @id @default(autoincrement())
    probability Float // Replaces probability in Allele
    alleleId    Int
    allele      Allele @relation(fields: [alleleId], references: [id], onDelete: Cascade)
    breedId     Int
    breed       Breed  @relation(fields: [breedId], references: [id], onDelete: Cascade)
    @@unique([alleleId, breedId])
}

// Breed level stat ranges
model StatRange {
    id      Int   @id @default(autoincrement())
    min     Float
    max     Float
    stat    String // Must match a Stat in StatDefinition
    breedId Int
    breed   Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)
    @@unique([stat, breedId])
}

// Generated individual belonging to a breed
model Animal {
    id              Int      @id @default(autoincrement())
    createdAt       DateTime @default(now())
    name            String
    age             Float    @default(0)
    breedId         Int
    breed           Breed    @relation(fields: [breedId], references: [id], onDelete: Cascade)
    expressedTraits Json
    stats           Json
    attributes      Json
    modifier        Json?
}