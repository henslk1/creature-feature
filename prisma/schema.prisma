generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Species {
    id          Int    @id @default(autoincrement())
    name        String @unique
    description String?
    attributes  AttributeDefinition[]
    stats       StatDefinition[]
    genes       Gene[]
    breeds      Breed[]
}

model AttributeDefinition {
    id        Int    @id @default(autoincrement())
    name      String
    type      String                  // number, string, ...
    min       Float?                  // When type has a range
    max       Float?                  // When type has a range
    options   String[]                // For type enum
    optional  Boolean @default(false)
    mutable   Boolean @default(false) // True if attribute can change, e.g. castration
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}

model StatDefinition {
    id        Int     @id @default(autoincrement())
    name      String
    min       Float
    max       Float
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}

model Gene {
    id              Int     @id @default(autoincrement())
    name            String
    category        String // Groups genes by type/scope
    loci            Locus[]
    expressionRules ExpressionRule[]
    speciesId       Int
    species         Species @relation(fields: [speciesId], references: [id])
}

model Locus {
    id      Int @id @default(autoincrement())
    name    String // e.g. "Extension Locus"
    alleles Allele[]
    geneId  Int
    gene    Gene @relation(fields: [geneId], references: [id])
}

model Allele {
    id          Int @id @default(autoincrement())
    name        String //e.g. "Extension E", "Extension e"
    symbol      String // "E", "e"
    dominance   String
    probability Float  // default
    overrides   AlleleOverride[]
    locusId     Int
    locus       Locus @relation(fields: [locusId], references: [id])
}

// Expression rule defines what behavior a gene has based on the number of dominant alleles
model ExpressionRule {
    id                 Int @id @default(autoincrement())
    minDominantAlleles Int // What determines expression
    expression         String // Trait displayed, e.g. "Blue eyes"
    geneId             Int
    gene               Gene @relation(fields: [geneId], references: [id])
}

model Breed {
    id        Int @id @default(autoincrement())
    name      String
    overrides AlleleOverride[]
    modifiers Modifier[]
    animals   Animal[]
    speciesId Int
    species   Species @relation(fields: [speciesId], references: [id])
}

// enables individual breeds to alter probabilities
model AlleleOverride {
    id          Int    @id @default(autoincrement())
    probability Float // Replaces probability in Allele
    alleleId    Int
    allele      Allele @relation(fields: [alleleId], references: [id])
    breedId     Int
    breed       Breed  @relation(fields: [breedId], references: [id])
}

model Modifier {
    id      Int @id @default(autoincrement())
    name    String
    stat    String // Must match a Stat in StatDefinition
    value   Float
    breedId Int
    breed   Breed @relation(fields: [breedId], references: [id])
}

// Generated individual belonging to a breed
model Animal {
    id              Int @id @default(autoincrement())
    name            String 
    age             Float @default(0)
    breedId         Int
    breed           Breed @relation(fields: [breedId], references: [id])
    expressedTraits Json
    stats           Json
    modifier        Json?
}